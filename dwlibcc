#! /bin/sh --
#
# dwlibcc: C compiler driver for dwlibc, a toolchain to create stanalone, combined DOS--Win32 .exe programs and combined Linux--FreeBSD i386 ELF-32 programs on Linux i386 (or amd64)
# by pts@fazekas.hu at Sun Nov  8 16:20:04 CET 2026
#
# Example first-run compile: ./dwlibcc -s -Os -W -Wall -Wextra -Werror -std=c89 -o helldspe.exe helldspe.c
#
# Command-line flags are passed to owcc (OpenWatcom v2 C compiler frontend),
# for example, disable a warning like this: `dwlibcc -Wno-n201'.
#
# Example compile of a larger project:
#
#   $ git clone https://github.com/pts/luuzcat
#   $ (cd luuzcat && ../dwlibcc         -s -Os -W -Wall -Wextra -Werror -std=c89 -include dwlibc.h -DLIBC_PREINCLUDED -D_LIBC_USE_MAIN1 -o luuzcat.exe luuzcat.c unscolzh.c uncompact.c unopack.c unpack.c undeflate.c uncompress.c unfreeze.c)
#   $ (cd luuzcat && ../dwlibcc -blinux -s -Os -W -Wall -Wextra -Werror -std=c89 -include dwlibc.h -DLIBC_PREINCLUDED -D_LIBC_USE_MAIN1 -o luuzcat     luuzcat.c unscolzh.c uncompact.c unopack.c unpack.c undeflate.c uncompress.c unfreeze.c)
#   $ ls -ld luuzcat/luuzcat luuzcat/luuzcat.exe
#
# Example compile of a larger project using more libc functions:
#
#   $ git clone https://github.com/pts/mininasm
#   $ (cd mininasm && ../dwlibcc         -s -Os -W -Wall -Wextra -Werror -std=c89 -include dwlibc.h -DCONFIG_SKIP_LIBC -o mininasm.exe mininasm.c)
#   $ (cd mininasm && ../dwlibcc -blinux -s -Os -W -Wall -Wextra -Werror -std=c89 -include dwlibc.h -DCONFIG_SKIP_LIBC -o mininasm     mininasm.c)
#   $ ls -ld mininasm/mininasm mininasm/mininasm.exe
#
# Example compile of a larger project using even more libc functions:
#
#   $ git clone https://github.com/pts/minixbcc
#   $ minixbcc/cross.sh --no-cc --no-cpp "$PWD"/dwlibcc -bfreebsd -include dwlibc.h -s -Os -W -Wall -Wextra -Werror -std=c89 -D_LIBC_USE_FAKE_FREE -DLIBCH -DNOEXECUTABLE
#   $ ls -ld minixbcc/libexec/* minixbcc/*/*.a
#
# General usage of dwlibcc:
#
# * The dwlibcc command of dwlibcc is  a C compiler driver, which create
#   stanalone, text-mode (console), combined DOS--Win32 .exe programs from C
#   source. The same .exe runs on DOS (with a 80386 or later CPU), Windows
#   (Win32 i386, also on 64-bit Intel Windows using WoW64), Windows
#   emulators (such as Wine) and and OS/2 >=2.0 DOS window. There is no need
#   to install anything or copy any other file (in addition to the program
#   .exe file) to the target matchine, the generated program .exe file is
#   standalone and self-contained.
# * dwlibcc runs on Linux i386 (and amd64) only. That's partly restricted by
#   the host systems the OpenWatcom v2 compiler supports. It would be
#   possible to make it work on Win32 as well.
# * dwlibcc accepts command-line flags and arguments just like the owcc C
#   compiler driver in OpenWatcom v2, which is a bit similar to gcc. See
#   example invocations above.
# * dwlibcc uses owcc under the hood, it passes many flags to it by default,
#   and after these dwlibcc-specific flags it passes almost all arguments
#   the user has passed to dwlibcc.
# * The dwlibcc-specific command-line flags must all be specified at the
#   beginning of the dwlibcc command line (in any order). They are:
#   * -bdoswin32 (default): Build combined DOS--Win32 .exe program file.
#   * -bdos32: Build DOS-only .exe program file. It works on DOS >=2.0.
#     It needs a 80386 or later CPU. If the program doesn't call
#     malloc(...), it works even with just 640 KiB of RAM, even malloc(...)
#     works. The memory requirement before the first malloc(...) call
#     on DOS is: 21 KiB + SizeOfImage + SizeOfStackCommit.
#   * -bwin32: Build Win32-only .exe program file. It works on Windows NT
#     3.1 (1993) or later, and Windows 95 (1995), even on Windows 10 and
#     Windows 11.
#   * -blinux: Build Linux i386 ELF-32 executable program file. It works
#     on Linux kernel >=1.0.
#   * -bfreebsdx: Build combined Linux--FreeBSD i386 ELF-32 executable
#     program file. It works on Linux kernel >=1.0 and FreeBSD >=3.0.
#   * -bany: Build system-independent object files. All system-specific
#     declarations (including I/O functions such as write(...)) will be
#     hidden in <dwlibc.h>, and linking (if attempted) will fail with
#     undefined symbols.
#   * --nasm=...: NASM command name to build the PMODE/W DOS extender
#     for -bdoswin32 and -bdos.
# * The default program stack size is as little as 8 KiB. Specify something
#   larger if needed, e.g. `-mstack=64k'. On Linux and FreeBSD, the stack
#   size setting is ignored.
#
# Limitations of dwlibc:
#
# * It supports creating text-mode (console) programs only, it doesn't
#   support any GUI.
# * It provides only a few functions:
#   * File (and console) I/O: open00, create1, close, read, write, lseek,
#     isatty, rename == unlink.
#   * Process management: exit == _exit.
#   * Dynamic memory: malloc only (no relloc, no free).
#   * Integer helpers: abs, labs, _rotl, _rotr, _lrotl, _lrotr.
#   * Strings: memchr, memcmp, memcpy, memset, strcat, strchr, strcmp,
#     strcpy, strlen.
#   * ASCII character classes: isalnum, isalpha, isascii, isdigit, islower,
#     isprint, isspace, isupper, isxdigit.
#   * ASCII character transformation: tolower, toupper.
#   * No buffered file I/O, i.e. no printf, fwrite, putchar, scanf, fread.
#   * (More functions can be added as needed.)
# * It doesn't support function error codes (errno).
# * It doesn't pass the environment variables (environ) to the program.
# * All libc functions are inlined, so the more function call code locations
#   you have, the larger your output .exe becomes. (This could be fixed by
#   a redesign from header-only to .obj-in-.lib.)
# * It doesn't do any CRLF-to-LF trasnlation, all I/O is binary. It supports
#   8 bits (i.e. the ANSI encodings) in characters in filenames, on the
#   command line and on the console.
# * It doesn't support multithreaded programs.
# * It doesn't support long filenames on DOS. (It could be added, first
#   PMODE/W, then to the libx.)
# * It doesn't support command-line strings longer than 126 bytes on DOS.
# * The -bwin32 and -bdoswin32 .exe imports even those Win32 functions
#   from kernel32.dll which it doesn't use. (This could be fixed by
#   running wlink twice, and creating a shorter .lnk file in-between.)
# * No floating-point support. (Some simple operations may work.) No
#   floating-point emulation support.

mydir=.
test "$0" = "${0%/*}" || mydir="${0%/*}"
test "${mydir#-}" = "$mydir" || mydir="./$mydir"
if test "$1" != --sh-script; then
  exec "$mydir/tools/busybox-minicc-1.21.1.upx" env -i sh "$0" --sh-script "$@" || exit 1
fi
shift;  # Remove the --sh-script argument.

set -e
unset LANG LANGUAGE
export LC_ALL=C  # For reproducible builds.
export TZ=GMT  # For reproducible builds.

unset INC LIB LIBDIR WLINK_LNK WATCOM INCLUDE

v=
for arg in "$@"; do case "$arg" in -v) v="$arg" ;; esac; done
if test "$v"; then (exec 2>&1 && set -x && : "$0" "$@"); fi  # Print our own command without running it if -v was specified.

target=; nasm=; stack=8K; prepare=
dosxt="$mydir"/pmodewd.exe
argflag=; exefn=; needexefn=1; exportall="-Wl,op -Wl,exporta"; ns=-ns
pmodew_message="PMODE/W v1.33 (C)Daredevil and Tran."
if test "$1" = --prepare; then
  prepare=1; needexefn=1
  rm -f "$dosxt" "$mydir"/tools/owcc "$mydir"/tools/wcc386 "$mydir"/tools/wlink "$mydir"/tools/specs.owc "$mydir"/wi64.lib "$mydir"/tools/sstrip
elif test "$1" = --check; then
  set -x
  test -f "$dosxt"
  test -f "$mydir"/dwlibc.h
  test -f "$mydir"/tools/owcc
  test -x "$mydir"/tools/owcc
  test -f "$mydir"/tools/wcc386
  test -x "$mydir"/tools/wcc386
  test -f "$mydir"/tools/wlink
  test -x "$mydir"/tools/wlink
  test -f "$mydir"/tools/specs.owc
  test -f "$mydir"/wi64.lib
  test -f "$mydir"/tools/sstrip
  test -x "$mydir"/tools/sstrip
  : : "$0" check OK.
  set +x; exit 0
else
  usage2="Usage: $0 [-bdoswin32|-bdos32|-bwin32|-blinux|-bfreebsdx] -o <output-exe> [<option>...] file.c"
  while ! test "$target"; do
    case "$1" in
     "" | -\? | -v) echo "$usage"; exec "$mydir"/tools/owcc "$@" 2>&1 ;;
     --help) shift; echo "$usage"; exec "$mydir"/tools/owcc -\? "$@" 2>&1 ;;
     --nasm=*) nasm="${1#*=}"; shift ;;
     -bdos | -bdos32 | -bpmodew) shift; target=dos32 ;;
     -bwin32) shift; target=win32; dosxt= ;;
     -bdoswin32) shift; target=doswin32 ;;
     -blinux) shift; target=linux; dosxt= ;;
     -bfreebsd | -bfreebsdx) shift; target=freebsdx; dosxt= ;;  # -bfreebsd would be only FreeBSD without Linux. We don't support that.
     -bany | -banyos) shift; target=any; dosxt= ;;  # Similar to `minicc -bany' in https://github.com/pts/minilibc686 , but here system-specific and I/O functions (e.g. write(...)) won't even be declared.
     -mstack=*) stack="${1#*=}"; shift; continue ;;  # The syntax is whatever wlink accepts, e.g. -mstack=8k means 8192 bytes.
     *) target=doswin32 ;;
    esac
  done
  for arg in "$@"; do
    case "$argflag" in -o) exefn="$arg" ;; esac
    argflag=
    case "$arg" in
     -b*) echo "fatal: move target flag to the beginning: $arg" >&2; exit 1 ;;
     -o?*) exefn="${arg#-?}" ;;
     -o) argflag="$arg" ;;
     -[cSE]) needexefn= ;;
     -s) exportall=; ns= ;;
    esac
  done
  if test "$needexefn" && ! test "$exefn"; then
    echo "fatal: missing output filename, please specify -o ..." >&2; exit 1
  fi
fi

if ! test -f "$mydir/tools/owcc"; then
  (cd "$mydir"/tools && ./owcc-ow2023-03-04.7z -y) || exit "$?"  # Self-extracting archive on Linux i386 (or amd64).
  : >"$mydir"/tools/specs.owc  # An empty file is good enough for owcc.
  for f in owcc wcc386 wlink; do
    if test -f "$mydir/tools/$f" && test -x "$mydir/tools/$f"; then :; else
      echo "fatal: could not extract: tools/$f" >&2; exit 102
    fi
  done
fi

if test "$needexefn"; then
  if ! test -f "$mydir/wi64.lib"; then  # Build the library containing the 64-bit integer functions e.g. __I8M.
    if ! test "$nasm"; then
      nasm="$mydir"/tools/nasm-0.98.39.upx
      "$nasm" -v >/dev/null 2>&1 || nasm=nasm  # Use the system nasm if the bundled "$nasm" doesn't work.
    fi
    for f in i8d i8rs u8d u8ls u8m u8rs; do
      (cd "$mydir" && set -x && "$nasm" -O0 -w+orphan-labels -f obj -o "$f".obj i64/i64_"$f".nasm) || exit "$?"
    done
    (cd "$mydir" && set -x && "$nasm" -O0 -w+orphan-labels -f bin -o wi64.lib wi64.nasm) || exit "$?"
    (cd "$mydir" && rm -f i8dr.obj i8rs.obj u8d.obj u8ls.obj u8m.obj u8rs.obj) || exit "$?"
    if ! test -f "$mydir/wi64.lib"; then echo "fatal: could not build: wi64.lib" >&2; exit 101; fi
  fi
  if ! test -f "$mydir"/tools/sstrip; then  # Do a direct compile (using "$mydir"/tools/owcc) of tools/sstrip.c to tools/sstrip , targeting Linux i386.
     rm -f "$mydir"/tools/sstrip.tmp
     # We are doing a cd here so that sstrip.o ends up in "$mydir"/tools.
     (set -x && cd "$mydir"/tools && PATH=. owcc -bbegin -Wc,-bt=linux -Wl,x -Wl,end -Wl,form -Wl,elf -Wl,ru -Wl,lin -Wl,op -Wl,nor -Wl,op -Wl,d -Wl,op -Wl,nored -Wl,op -Wl,start=_dwlibcstart_ -fnostdlib -fno-stack-check -finline-intrinsics -fsigned-char -march=i386 -D__DWLIBC__ -DENABLE_PEPATCH -s -Os -W -Wall -Wextra -Werror -std=c89 -include ../dwlibc.h -o sstrip.tmp sstrip.c) || exit "$?"
     test -f "$mydir"/tools/sstrip.tmp
     cat "$mydir"/tools/sstrip.tmp >"$mydir"/tools/sstrip.tmp2
     chmod +x "$mydir"/tools/sstrip.tmp2
     (set -x && "$mydir"/tools/sstrip.tmp -l "$mydir"/tools/sstrip.tmp2) || exit "$?"
     rm -f "$mydir"/tools/sstrip.tmp "$mydir"/tools/sstrip.o
     mv "$mydir"/tools/sstrip.tmp2 "$mydir"/tools/sstrip
    for f in sstrip; do
      if test -f "$mydir/tools/$f" && test -x "$mydir/tools/$f"; then :; else
        echo "fatal: could not extract: tools/$f" >&2; exit 102
      fi
    done
  fi
fi

if test "$dosxt" && ! test -f "$dosxt"; then  # Build the DOS extender DOS stub pmodewd.exe upon first run.
  if ! test "$nasm"; then
    nasm="$mydir"/tools/nasm-0.98.39.upx
    "$nasm" -v >/dev/null 2>&1 || nasm=nasm  # Use the system nasm if the bundled "$nasm" doesn't work.
  fi
  set -x  # Enable echo of commands run.
  (cd "$mydir" && "$nasm" -O32700 -w+orphan-labels -DPMWV=33 -DLOGO=0 -DSIZEOPT=1 -DCONFIGTYPE=2 -DLOADSPE=3 -DSPECUSTOMENTRY=2 -DLOADLE=0 -DLOADPMW1=0 -DEXCEPTIONS=1 -DINT3108FUNC=0 -DINT1B=2 -DINT33=0 -DINT31VENDOR=0 -DFREEMEMINFO=0 -DGETVERSION=0 -DABORTMSGTTY=1 -DEXITCODE=1 -DSHORTMSG=1 -o pmodewdu.exe pmodew.nasm) || exit "$?"
  (cd "$mydir" && "$nasm" -O0 -w+orphan-labels -DPMWV=33 -DLOGO=0 -DCONFIGINEXEIMAGE=2 -DPM_SELECTORS=4 -o pmwca pmwcax.nasm) || exit "$?"
  chmod +x "$mydir"/pmwca
  (cd "$mydir" && ./pmwca pmodewdu.exe pmodewd.exe) || exit "$?"  # This runs on Linux i386, Linux amd64 and FreeBSD i386.
  rm -f pmodewdu.exe pmwca
  set +x  # Disable echo of commands run.
fi

test "$prepare" && exit

# This design of doing the full compile and link without .asm or object (.o) files is based on: https://stackoverflow.com/a/62495257 . It cannot provide the 64-bit integer functions (e.g. __I8M).
# `owcc -bbegin' passes `system begin' to wlink and `-bt=begin\ (default-mapped) to wcc396.
# There mapping from `owcc -banything' to `wcc386 ...' flags is defined in the specs file bin*/specs.owc. If `system begin anything' is not found there, then the default flag will be `wcc386 -bt=anything'.
# Typical `-bt=...' values in bin*/specs.owc: dos (both 16-bit and 32-bit), nt (Win32, 32-bit), windows (Windows 3.1, 16-bit), linux (i386, 32-bit), os2 (both 16-bit and 32-bit), netware (i386, 32-bit), qnx (i386, 32-bit), zdos, rdos, rdosdev, rdos_*.
# wcc386 takes the last -bt=anything flag value passed to it, capitalizes it, and defines the macro like `wcc386 -D__ANYTHING__=1' (same as C code `#define __ANYTHING__ 1').
# If wcc386 doesn't get any -bt=anything flag, then it will use the host system name (e.g. linux if compiling on Linux, nt if compiling on Win32), e.g. `wcc386 -D__LINUX__=1'.
# !! SizeOfHeapReserve is generated as 0. Why? Does owcc always do this? Patch it with sstrip.
export PATH="$mydir"/tools  # owcc finds specs.owc, wcc386 and wlink on $PATH. It doesn't even look at its own directory.
export INCLUDE="$mydir"  # For `#include <dwlibc.h>'.
set x $v -Wl,op -Wl,d -Wl,op -Wl,nored -Wl,op -Wl,noext -Wl,op -Wl,start=_dwlibcstart_ -Wl,l -Wl,"$mydir"/wi64.lib -fnostdlib -finline-intrinsics -fsigned-char -march=i386 -D__DWLIBC__ $dss "$@"; shift
if test "$target" = dos32; then
  set owcc -bbegin -Wc,-bt=dos -Wl,x -Wl,end -Wl,form -Wl,win -Wl,nt -Wl,ru -Wl,con=3.10 -Wl,op -Wl,h=4K -Wl,com -Wl,h=4K -Wl,op -Wl,st=256K -Wl,com -Wl,st="$stack" -Wl,op -Wl,stub="$dosxt"              "$@"
elif test "$target" = win32; then
  export WLINK_LNK="$mydir"/dwlibc_win32.lnk
  set owcc -bbegin -Wc,-bt=nt  -Wl,x -Wl,end -Wl,form -Wl,win -Wl,nt -Wl,ru -Wl,con=3.10 -Wl,op -Wl,h=4K -Wl,com -Wl,h=4K -Wl,op -Wl,st=256K -Wl,com -Wl,st="$stack"                                       "$@"
elif test "$target" = doswin32; then
  export WLINK_LNK="$mydir"/dwlibc_win32.lnk
  set owcc -bbegin -Wc,-bt=nt  -Wl,x -Wl,end -Wl,form -Wl,win -Wl,nt -Wl,ru -Wl,con=3.10 -Wl,op -Wl,h=4K -Wl,com -Wl,h=4K -Wl,op -Wl,st=256K -Wl,com -Wl,st="$stack" -Wl,op -Wl,stub="$dosxt"  -D__DOS__   "$@"
elif test "$target" = linux; then
  # `op obja=16' creates incorrectly aligned ELF which Linux can run. !! Write a post-processing tool which relocates _DATA.
  set owcc -bbegin -Wc,-bt=linux        -Wl,x -Wl,end -Wl,form -Wl,elf -Wl,ru -Wl,lin -Wl,op -Wl,nor -Wl,op -Wl,obja=4k $exportall "$@"
elif test "$target" = freebsdx; then
  # `op obja=16' creates incorrectly aligned ELF which FreeBSD 3.0 can't run (it fails with: Abort trap). !! Write a post-processing tool which relocates _DATA.
  set owcc  -bbegin -Wc,-bt=freebsd -Wl,x -Wl,end -Wl,form -Wl,elf -Wl,ru -Wl,fre -Wl,op -Wl,nor -Wl,op -Wl,obja=4k $exportall -D__LINUX__ "$@" || exit "$?"
elif test "$target" = any; then
  set owcc -bbegin -Wc,-bt=anyos -Wl,x -Wl,end -Wl,form -Wl,elf -Wl,ru -Wl,lin -Wl,op -Wl,nor -Wl,op -Wl,obja=4k $exportall "$@"
else
  echo "$0: fatal: target not implemented: -b$target" >&2; exit 1
fi
! test "$v"  || (exec 2>&1 && set -x && : "$@") || exit "$?"
"$@"
if test "$needexefn"; then
  if test "$target" = dos32; then      set sstrip -p1 -m "$pmodew_message" -- "$exefn"
  elif test "$target" = doswin32; then set sstrip     -m "$pmodew_message" -- "$exefn"
  elif test "$target" = linux; then    set sstrip -ll $ns -- "$exefn"
  elif test "$target" = freebsdx; then set sstrip -lf $ns -- "$exefn"  # Only -lf (EI_OSABI and EI_BRAND FreeBSD) is needed for FreeBSD to run the program, in addition to `op obja=4k'.
  fi
  if test "$2"; then
    ! test "$v"  || (exec 2>&1 && set -x && : "$@") || exit "$?"
    "$@"
  fi
fi
if test "$v"; then (exec 2>&1 && set -x && : : "$0" OK.); fi

# __END__
